{
  "name": "fxtrack",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fxtrack/web",
    "build": "npm run build --workspace @fxtrack/web",
    "check": "npm run check --workspaces --if-present",
    "tick": "npm run tick --workspace @fxtrack/worker",
    "snap": "npm run snap --workspace @fxtrack/worker",
    "backfill": "npm run backfill --workspace @fxtrack/worker"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260917.1": true
  }
}
