{
  "name": "@fxtrack/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/job.ts src/snap.ts --bundle --platform=node --format=esm --target=node22 --outdir=.tmp --log-level=warning",
    "tick": "npm run bundle && node .tmp/job.js",
    "snap": "npm run bundle && node .tmp/snap.js",
    "backfill": "node scripts/backfill.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fxtrack/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2"
  }
}
